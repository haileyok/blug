# ATProtocol configuration — see README for how to find these values.
ATP_SERVICE=https://your-pds.example.com/
ATP_IDENTIFIER=your-handle.com
ATP_DID=did:plc:yourdidhere

# standard.site publication verification — see README "standard.site".
# rkey of your site.standard.publication record. "self" is the convention
# used by Leaflet / Offprint / pckt.blog; only change it if yours differs.
#ATP_PUBLICATION_RKEY=self

# Where Redis is running (default: redis://127.0.0.1:6379).
#REDIS_URL=redis://127.0.0.1:6379
