{
  "name": "blug",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "dotenv -e .env remix vite:build",
    "dev": "remix vite:dev",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "dotenv -e .env remix-serve ./build/server/index.js",
    "typecheck": "tsc",
    "validate:standard-site": "dotenv -e .env tsx scripts/validate-standard-site.ts",
    "fix-document-site": "dotenv -e .env tsx scripts/fix-document-site.ts"
  },
  "dependencies": {
    "@atproto/api": "^0.12.2",
    "@remix-run/node": "^2.17.5",
    "@remix-run/react": "2.17.5",
    "@remix-run/serve": "^2.17.5",
    "ioredis": "^5.3.2",
    "isbot": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.2",
    "@eslint/js": "^9.0.0",
    "@remix-run/dev": "^2.17.5",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "autoprefixer": "^10.4.19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.38.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-prettier": "^0.0.0-empty",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5.1.6",
    "vite": "^7.3.5",
    "vite-tsconfig-paths": "^4.2.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
